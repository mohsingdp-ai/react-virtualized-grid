{
  "name": "@mejazbese21/react-window-sticky-grid",
  "version": "1.7.0",
  "description": "Virtualized React grid with sticky header and pinned columns, for very large row and column counts.",
  "keywords": [
    "react",
    "grid",
    "table",
    "virtualized",
    "sticky",
    "react-window"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohsingdp-ai/react-virtualized-grid.git"
  },
  "homepage": "https://github.com/mohsingdp-ai/react-virtualized-grid#readme",
  "bugs": {
    "url": "https://github.com/mohsingdp-ai/react-virtualized-grid/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --outDir demo-dist",
    "test": "node --test \"src/lib/*.test.js\"",
    "prepublishOnly": "npm test && npm run test:e2e && npm run build",
    "test:e2e": "node --test \"e2e/*.test.mjs\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "react-window": "^2.3.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
